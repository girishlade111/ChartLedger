# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL runtime variables (injected automatically by AI Studio Cloud SQL)
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Optional AI configuration
AI_PROVIDER="gemini"
AI_MODEL="gemini-4-hydrogen"
EMBEDDING_MODEL="gemini-embedding-2"
DEMO_MODE="false"

# Optional Stripe Test Mode configuration (server-side only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Optional Market Data provider override (default: binance_public for crypto spot pairs)
MARKET_DATA_PROVIDER="binance_public"

# Optional Admin Email override (defaults to workspace owner email)
ADMIN_EMAIL=
